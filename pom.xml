<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.realorji</groupId>
    <artifactId>karate-framework</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Karate API Automation Framework</name>
    <description>API test automation framework built on Karate, with manual test case traceability.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <karate.version>1.5.2</karate.version>
        <cucumber.reporting.version>5.12.0</cucumber.reporting.version>
        <surefire.version>3.6.0</surefire.version>
        <compiler.plugin.version>3.16.0</compiler.plugin.version>

        <!-- Runtime knobs; override on the command line, e.g. -Dkarate.env=staging -Dthreads=8 -->
        <karate.env>qa</karate.env>
        <threads>5</threads>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.karatelabs</groupId>
            <artifactId>karate-junit5</artifactId>
            <version>${karate.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.masterthought</groupId>
            <artifactId>cucumber-reporting</artifactId>
            <version>${cucumber.reporting.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Karate convention: keep .feature / .json / .js files next to the Java runners. -->
        <testResources>
            <testResource>
                <directory>src/test/java</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </testResource>
        </testResources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler.plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!-- The suite runner executes every feature in parallel; module runners are for IDE use. -->
                    <includes>
                        <include>com/realorji/api/ApiTestSuite.java</include>
                        <include>com/realorji/api/traceability/TraceabilityTest.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <karate.env>${karate.env}</karate.env>
                        <threads>${threads}</threads>
                    </systemPropertyVariables>
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
